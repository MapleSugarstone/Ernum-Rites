{
  "name": "selatza",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test:watch": "vitest",
    "fuzz": "dotnet run -c Release --project csharp/Selatza.Train -- fuzz",
    "patterns": "dotnet run -c Release --project csharp/Selatza.Train -- patterns",
    "mirror": "dotnet run -c Release --project csharp/Selatza.Train -- mirror",
    "q": "dotnet run -c Release --project csharp/Selatza.Train -- query",
    "db": "dotnet run -c Release --project csharp/Selatza.Train -- db",
    "sql": "dotnet run -c Release --project csharp/Selatza.Train -- sql",
    "tune": "vite-node scripts/tune.ts --",
    "polish": "vite-node scripts/polish.ts --",
    "suspects": "vite-node scripts/suspects.ts",
    "atlas": "vite-node scripts/atlas.mts",
    "cs:build": "dotnet build csharp/Selatza.Engine -v q --nologo",
    "cs:release": "dotnet build csharp/Selatza.Train -c Release -v q --nologo && dotnet build csharp/Selatza.Sim -c Release -v q --nologo",
    "cs:test": "dotnet run --project csharp/Selatza.Tests",
    "cs:sim": "dotnet run -c Release --project csharp/Selatza.Sim --",
    "replays:record": "dotnet run -c Release --project csharp/Selatza.Sim -- record --games 12",
    "replays:verify": "dotnet run -c Release --project csharp/Selatza.Sim -- verify",
    "conform": "vitest run tests/conformance.test.ts",
    "train": "dotnet run -c Release --project csharp/Selatza.Train -- train",
    "rr": "dotnet run -c Release --project csharp/Selatza.Train -- roundrobin",
    "logstats": "dotnet run -c Release --project csharp/Selatza.Train -- logstats",
    "train:meta": "dotnet run -c Release --project csharp/Selatza.Train -- train --no-net --rounds 400 --agents 24 --games 8",
    "train:matchup": "dotnet run -c Release --project csharp/Selatza.Train -- matchup",
    "train:diff": "dotnet run -c Release --project csharp/Selatza.Train -- diff",
    "train:probe": "dotnet run -c Release --project csharp/Selatza.Train -- probe",
    "train:deck": "dotnet run -c Release --project csharp/Selatza.Train -- deck",
    "train:bench": "dotnet run -c Release --project csharp/Selatza.Train -- bench",
    "train:check": "dotnet run -c Release --project csharp/Selatza.Train -- gradcheck",
    "train:gauntlet": "dotnet run -c Release --project csharp/Selatza.Train -- gauntlet",
    "net:refresh": "dotnet run -c Release --project csharp/Selatza.Train -- export-net --net src/ai/net/default.snn --out src/ai/net/default.json && dotnet run -c Release --project csharp/Selatza.Train -- dump-obs --net src/ai/net/default.snn --replay replays/012-sweetshop-store.json --every 5 --out conformance/net-parity.json",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.125.0"
  }
}
